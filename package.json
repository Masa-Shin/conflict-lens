{
  "name": "conflict-lens",
  "displayName": "%conflictLens.displayName%",
  "description": "%conflictLens.description%",
  "version": "1.2.3",
  "publisher": "Masa-Shin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Masa-Shin/conflict-lens.git"
  },
  "bugs": {
    "url": "https://github.com/Masa-Shin/conflict-lens/issues"
  },
  "homepage": "https://github.com/Masa-Shin/conflict-lens#readme",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "conflict",
    "merge",
    "highlight",
    "diff",
    "base branch",
    "pull request",
    "code review"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#FFF8E1",
    "theme": "light"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%conflictLens.capabilities.untrustedWorkspaces.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "conflictLens.enable",
        "title": "%conflictLens.command.enable.title%",
        "category": "%conflictLens.command.category%"
      },
      {
        "command": "conflictLens.disable",
        "title": "%conflictLens.command.disable.title%",
        "category": "%conflictLens.command.category%"
      },
      {
        "command": "conflictLens.toggle",
        "title": "%conflictLens.command.toggle.title%",
        "category": "%conflictLens.command.category%"
      },
      {
        "command": "conflictLens.selectBaseBranch",
        "title": "%conflictLens.command.selectBaseBranch.title%",
        "category": "%conflictLens.command.category%"
      },
      {
        "command": "conflictLens.refresh",
        "title": "%conflictLens.command.refresh.title%",
        "category": "%conflictLens.command.category%"
      },
      {
        "command": "conflictLens.showChangedFiles",
        "title": "%conflictLens.command.showChangedFiles.title%",
        "category": "%conflictLens.command.category%"
      },
      {
        "command": "conflictLens.showConflictFiles",
        "title": "%conflictLens.command.showConflictFiles.title%",
        "category": "%conflictLens.command.category%"
      },
      {
        "command": "conflictLens.showBaseChanges",
        "title": "%conflictLens.command.showBaseChanges.title%",
        "category": "%conflictLens.command.category%"
      },
      {
        "command": "conflictLens.previewConflict",
        "title": "%conflictLens.command.previewConflict.title%",
        "category": "%conflictLens.command.category%"
      },
      {
        "command": "conflictLens.showOutputChannel",
        "title": "%conflictLens.command.showOutputChannel.title%",
        "category": "%conflictLens.command.category%"
      },
      {
        "command": "conflictLens.copyMcpRegistration",
        "title": "%conflictLens.command.copyMcpRegistration.title%",
        "category": "%conflictLens.command.category%"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Conflict Lens",
      "properties": {
        "conflictLens.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%conflictLens.config.enabled.description%"
        },
        "conflictLens.remoteName": {
          "type": "string",
          "default": "origin",
          "scope": "resource",
          "description": "%conflictLens.config.remoteName.description%"
        },
        "conflictLens.showOverviewRuler": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%conflictLens.config.showOverviewRuler.description%"
        },
        "conflictLens.showFileDecorationBadges": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%conflictLens.config.showFileDecorationBadges.description%"
        },
        "conflictLens.remoteCheckIntervalMinutes": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "maximum": 1440,
          "scope": "window",
          "description": "%conflictLens.config.remoteCheckIntervalMinutes.description%"
        },
        "conflictLens.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%conflictLens.config.mcp.enabled.description%"
        },
        "conflictLens.notifyConflictsAfterFetch": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%conflictLens.config.notifyConflictsAfterFetch.description%"
        }
      }
    },
    "colors": [
      {
        "id": "conflictLens.changedLineBackground",
        "description": "%conflictLens.color.changedLineBackground.description%",
        "defaults": {
          "dark": "#ff9d4520",
          "light": "#ee6e0816",
          "highContrast": "#ff9d4540",
          "highContrastLight": "#c45a0890"
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "conflictLens.showBaseChanges",
          "when": "conflictLens.hasBaseChange",
          "group": "conflictLens@1"
        },
        {
          "command": "conflictLens.previewConflict",
          "when": "conflictLens.hasBaseChange",
          "group": "conflictLens@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "npm run build && code --extensionDevelopmentPath=\"$PWD\"",
    "build:prod": "npm run typecheck && node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit -p ./",
    "lint": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run build && npm run compile:integration && vscode-test",
    "vscode:prepublish": "npm run build:prod"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.2",
    "mocha": "^11.7.6",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "diff": "^9.0.0",
    "zod": "^4.5.4"
  }
}
