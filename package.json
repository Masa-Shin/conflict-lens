{
  "name": "conflict-lens",
  "displayName": "Conflict Lens",
  "description": "Visualize files and lines that may conflict with the base branch.",
  "version": "0.0.1",
  "publisher": "Masa-Shin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:prod": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run build:prod"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
