{
  "name": "conflict-lens",
  "displayName": "Conflict Lens",
  "description": "Visualize files and lines that may conflict with the base branch.",
  "version": "0.0.1",
  "publisher": "Masa-Shin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Conflict Lens executes git commands and reads workspace settings, so it requires a trusted workspace."
    }
  },
  "contributes": {
    "commands": [
      { "command": "conflictLens.enable", "title": "Enable", "category": "Conflict Lens" },
      { "command": "conflictLens.disable", "title": "Disable", "category": "Conflict Lens" },
      { "command": "conflictLens.toggle", "title": "Toggle", "category": "Conflict Lens" },
      { "command": "conflictLens.selectBaseBranch", "title": "Select Base Branch", "category": "Conflict Lens" },
      { "command": "conflictLens.refresh", "title": "Refresh", "category": "Conflict Lens" },
      { "command": "conflictLens.showChangedFiles", "title": "Show Changed Files", "category": "Conflict Lens" },
      { "command": "conflictLens.openDiff", "title": "Open Diff", "category": "Conflict Lens" },
      { "command": "conflictLens.showOutputChannel", "title": "Show Output Channel", "category": "Conflict Lens" }
    ],
    "configuration": {
      "type": "object",
      "title": "Conflict Lens",
      "properties": {
        "conflictLens.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Enable or disable Conflict Lens."
        },
        "conflictLens.baseBranch": {
          "type": "string",
          "default": "origin/main",
          "scope": "resource",
          "description": "Remote-tracking branch to compare against (e.g. origin/main). If unset, Conflict Lens tries to detect a default."
        },
        "conflictLens.deletedLineMarkerPosition": {
          "type": "string",
          "enum": ["nextLine", "previousLine", "none"],
          "default": "nextLine",
          "scope": "window",
          "description": "Gutter marker position for deletion-only diffs."
        },
        "conflictLens.showOverviewRuler": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show markers in the editor overview ruler."
        },
        "conflictLens.showGutterIcon": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show gutter icons for changed and conflicting lines."
        },
        "conflictLens.showFileDecorationColors": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Tint file names in Explorer / Open Editors for changed files."
        },
        "conflictLens.showFileDecorationBadges": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show warning badges on file names that may conflict."
        },
        "conflictLens.enableConflictPrediction": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Enable strong highlight using git merge-tree (requires Git 2.38+). Disable for very large repositories."
        },
        "conflictLens.remoteCheckIntervalMinutes": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "maximum": 1440,
          "scope": "window",
          "description": "Interval in minutes for polling remote updates with git ls-remote. Set to 0 to disable."
        },
        "conflictLens.autoFetchOnRemoteUpdate": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Automatically run git fetch and recompute when remote updates are detected."
        },
        "conflictLens.largeFileHunkThreshold": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 10000,
          "scope": "window",
          "description": "Suppress line highlights when a file has more diff hunks than this threshold."
        }
      }
    },
    "colors": [
      {
        "id": "conflictLens.changedLineBackground",
        "description": "Background color for lines changed on the base branch (weak highlight).",
        "defaults": {
          "dark": "#ffc80030",
          "light": "#b88a0030",
          "highContrast": "#ffff0040",
          "highContrastLight": "#a06800a0"
        }
      },
      {
        "id": "conflictLens.conflictLineBackground",
        "description": "Background color for lines that conflict with the base branch (strong highlight).",
        "defaults": {
          "dark": "#f14c4c50",
          "light": "#b0002050",
          "highContrast": "#ff000060",
          "highContrastLight": "#a000208c"
        }
      },
      {
        "id": "conflictLens.changedFileForeground",
        "description": "Foreground color for files changed relative to the selected base branch.",
        "defaults": {
          "dark": "#d7ba7d",
          "light": "#795e26",
          "highContrast": "#f0e68c",
          "highContrastLight": "#5a4500"
        }
      },
      {
        "id": "conflictLens.potentialConflictFileForeground",
        "description": "Foreground color for files that may conflict with the selected base branch.",
        "defaults": {
          "dark": "#f14c4c",
          "light": "#b00020",
          "highContrast": "#ff0000",
          "highContrastLight": "#8b0000"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:prod": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit -p ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run build:prod"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
